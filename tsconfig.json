{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 22",
  "_version": "22.0.0",
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext","DOM"
    ],
    "module": "ESNext",
    "rootDir": "./lib",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "guid-typescript": [
        "node_modules/guid-typescript/dist/guid.d.ts"
      ]
    },
    "typeRoots": [
      "node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "exclude": [
    "lib/test2.ts",
    "lib/index.ts",
    "src2"
  ]
}